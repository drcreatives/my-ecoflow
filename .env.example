# Next.js / Convex client
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Optional local app URL. Email links run in Convex: also set this variable on
# the Convex deployment, using the production app's HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy migration tooling only. Configure the same secret in Convex, run the
# migration, then remove/rotate it. Do not use a real value in this file.
MIGRATION_SECRET=replace-with-a-one-time-secret

# Set these in Convex Dashboard -> Settings -> Environment Variables:
# CONVEX_SITE_URL=https://your-deployment.convex.site
# ECOFLOW_ACCESS_KEY=replace-with-your-access-key
# ECOFLOW_SECRET_KEY=replace-with-your-secret-key
# RESEND_API_KEY=replace-with-your-resend-key
# GOOGLE_DRIVE_CLIENT_ID=replace-with-your-web-oauth-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=replace-with-your-web-oauth-client-secret
# TOKEN_ENCRYPTION_KEY=replace-with-64-random-hex-characters
# NEXT_PUBLIC_APP_URL=https://your-app.example.com
# DISABLE_CRONS=true
# Temperature collection is paused by default; explicit true re-enables it.
# TEMPERATURE_COLLECTION_ENABLED=false
